<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_phone_img" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/text_glow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:text="@string/app_name"
            android:textColor="@color/title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:shadowColor="@color/text_glow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:text="@string/home_subtitle"
            android:textColor="@color/hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/mode_det"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/btn_primary"
            android:text="@string/mode_det_title"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="@color/text_glow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:text="@string/mode_det_desc"
            android:textColor="@color/hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/mode_matmul"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/btn_navy"
            android:text="@string/mode_matmul_title"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:shadowColor="@color/text_glow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:text="@string/mode_matmul_desc"
            android:textColor="@color/hint"
            android:textSize="13sp" />

    </LinearLayout>
</FrameLayout>
