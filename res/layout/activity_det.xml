<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_phone_img" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="60dp"
            android:paddingRight="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/text_glow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/det_title"
                android:textColor="@color/title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="@color/text_glow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:text="@string/det_hint"
                android:textColor="@color/hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:shadowColor="@color/text_glow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:textColor="@color/timer"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cell00"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell01"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell02"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cell10"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell11"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell12"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cell20"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell21"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />

                <TextView
                    android:id="@+id/cell22"
                    style="@style/Cell"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:minHeight="62dp"
                android:shadowColor="@color/text_glow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textColor="@color/answer"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="@string/next"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/show_answer"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:text="@string/show_answer"
                    android:textAllCaps="false"
                    android:textColor="@color/secondary_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="@string/back"
        android:padding="9dp"
        android:src="@drawable/ic_arrow_back" />
</FrameLayout>
