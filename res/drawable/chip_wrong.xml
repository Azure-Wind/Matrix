<?xml version="1.0" encoding="utf-8"?>
<!-- A wrong-answer number whose last redo was reported as wrong: red. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/wrong_red" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/wrong_red_border" />
</shape>
